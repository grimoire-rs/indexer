---
// One version segment. Left-click copies the pinned identifier; right-click
// opens the grim commands for it, at the pointer. The menu is a native
// popover for the top layer (nothing can clip it, no z-index fights), but
// `manual`, not `auto`: an auto popover light-dismisses on the mouseup of
// the very right-click that opened it, so the menu flashes and vanishes.
// The page script therefore owns placement AND dismissal.
//
// The menu is drawn once per page (`menu`), not once per pill: every pill's
// five commands differ only in the reference, which the pill already carries
// in `data-copy`, so the script fills the shared menu from the pill that
// opened it. A `/p/` page is byte-capped.
interface Props {
  pkgRef?: string;
  tag?: string;
  current?: boolean;
  /** Draw the shared command menu instead of a pill. */
  menu?: boolean;
}
const { pkgRef = "", tag = "", current = false, menu = false } = Astro.props;
// `:latest` is what every grim command already resolves to with no tag, so
// spelling it out is noise the visitor has to delete — the bare ref is the
// same request. Every other tag pins and has to survive the copy.
const pinned = tag === "latest" ? pkgRef : `${pkgRef}:${tag}`;
const menuId = `vm-${tag.replace(/[^a-z0-9]+/gi, "-")}`;
const commands: [string, string][] = [
  ["copy reference", "{ref}"],
  ["add to project", "grim add {ref}"],
  ["add globally", "grim add --global {ref}"],
  ["describe", "grim describe {ref}"],
  ["fetch", "grim fetch {ref}"],
];
---

{
  menu ? (
    <div popover="manual" id="version-menu" class="version-menu">
      {commands.map(([label, cmd]) => (
        <button type="button" class="cmd" data-cmd={cmd} data-copy="" data-copy-name={`grim ${label}`}>
          <span>{label}</span>
        </button>
      ))}
    </div>
  ) : (
    <button
      type="button"
      class:list={["version", { current }]}
      data-slot="version-pill"
      data-copy={pinned}
      data-copy-name={tag === "latest" ? "reference" : `pinned ${tag}`}
      data-menu={menuId}
      aria-current={current ? "true" : undefined}>{tag}</button
    >
  )
}

<style>
@layer grimoire {
  /* Layered so a user CSS file (unlayered) outranks these rules. Astro
     scopes a component style to `.foo[data-astro-cid-…]` — specificity
     (0,2,0) — which beats a consumer's `.foo` in EITHER source order, so
     source order alone does not make this overridable. Not reindented:
     the wrapper stays a two-line diff. */
  /* No `span` inside: the shared copy script only swaps a label when it
     finds one, so the tag keeps its text and flashes the class instead. */
  .version {
    border: var(--grim-border-width) solid var(--grim-color-border);
    border-radius: var(--grim-radius-pill);
    background: transparent;
    padding: var(--grim-space-1) var(--grim-space-4);
    font-family: ui-monospace, "SFMono-Regular", monospace;
    font-size: var(--grim-text-sm);
    color: var(--grim-color-muted);
    white-space: nowrap;
    cursor: pointer;
  }
  .version:hover,
  .version:focus-visible {
    color: var(--grim-color-accent);
    border-color: var(--grim-color-accent);
    background: var(--grim-color-accent-soft);
  }
  .version.current {
    color: var(--grim-color-fg);
    font-weight: 600;
    border-color: var(--grim-color-accent);
  }
  .version.copied {
    color: var(--grim-color-accent);
    background: var(--grim-color-accent-soft);
  }

  .version-menu {
    /* Overrides the UA's centred `inset: 0; margin: auto` — the page script
       sets left/top from the pointer. */
    position: fixed;
    inset: auto;
    margin: 0;
    min-width: 11rem;
    padding: var(--grim-space-2);
    background: var(--grim-color-card);
    border: var(--grim-border-width) solid var(--grim-color-border);
    border-radius: var(--grim-radius-control);
    box-shadow: var(--grim-shadow-raised);
  }
  .cmd {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--grim-radius-inset);
    background: transparent;
    color: var(--grim-color-muted);
    font: inherit;
    font-size: var(--grim-text-sm);
    text-align: left;
    padding: var(--grim-space-2) var(--grim-space-4);
    cursor: pointer;
  }
  .cmd:hover,
  .cmd:focus-visible {
    background: var(--grim-color-chip-bg);
    color: var(--grim-color-fg);
  }
}
</style>
