---
// The marketplace landing view: the add-marketplace bar over the plugin
// catalog. `/marketplace/` renders it beside a package catalog and `/` renders
// it when the index has no packages, so the page decides title and description.
//
// Everything on this page that came from config (the URL, the name) is printed
// as text and never through `set:html`, so Astro's escaping is the sink. The
// command builders shell-quote the repository and refuse an unsafe name, so a
// value the reader let through still cannot become a second shell command.
import Base from "../layouts/Base.astro";
import Catalog from "./Catalog.tsx";
import CommandBar from "./CommandBar.astro";
import { BrandMark } from "./BrandMark.tsx";
import { cardPackage } from "../lib/catalog";
import { marketplaceAddChoices } from "../lib/commands";
import { ADD_REPOSITORY_HINT, PLUGIN_HREF } from "../lib/marketplace";
import { data } from "../lib/data";
import { listedPlugins } from "../lib/plugins";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const marketplace = data.marketplace;
// No `[marketplace].repository`: nothing to add, and the bar says what to set.
const repository = marketplace?.repository ?? null;
const addChoices =
  marketplace && repository !== null
    ? marketplaceAddChoices({ url: repository, clients: marketplace.clients })
    : [];
const plugins = listedPlugins(data);
---

<Base title={title} description={description}>
  <div class="hero">
    <h1>Plugin marketplace</h1>
    <p>
      Every plugin in this index, ready for your AI client. Add the marketplace once, then install
      plugins by name.
    </p>
    {
      repository === null ? (
        <div class="hero-side hero-side-stack">
          <p class="mk-hint">{ADD_REPOSITORY_HINT}</p>
        </div>
      ) : (
        <div class="hero-side hero-side-stack" data-os-switch data-os-noun="add command">
          {/* The harness cards are picks too: native radios carrying
              `data-os-pick` inside the same `[data-os-switch]` as the field's
              own picker, so either one swaps the command and checks both.
              `autocomplete="off"`: on Back the browser restores the old
              checked card after preselect runs, splitting card from command. */}
          <div class="mk-harness" role="radiogroup" aria-labelledby="mk-harness-label">
            <span class="side-label" id="mk-harness-label">Choose your harness</span>
            <div class="mk-picks">
              {addChoices.map((choice, i) => (
                <label class="mk-pick">
                  <input
                    type="radio"
                    name="mk-harness"
                    autocomplete="off"
                    checked={i === 0}
                    data-os-pick={choice.command}
                    data-os-name={choice.name}
                  />
                  {choice.path && <BrandMark path={choice.path} />}
                  <span data-label={choice.name}>{choice.name}</span>
                </label>
              ))}
            </div>
          </div>
          <div class="mk-add">
            <span class="side-label">Add the marketplace</span>
            <CommandBar
              choices={addChoices}
              noun="add command"
              copyLabel="Copy the add-marketplace command"
              pickerTitle="Harness"
              pickerLabel="Choose your harness"
            />
          </div>
        </div>
      )
    }
  </div>
  {/* The package catalog itself, fed plugin records: same cards and list,
      sort, kind chips and search, with links to the plugin pages and its own
      record file for the matcher. No VS Code action: a plugin has no grim ref. */}
  {
    plugins.length > 0 && (
      <Catalog
        client:load
        packages={plugins.map((plugin) => cardPackage(plugin.record))}
        vscodeExtension={null}
        builtAt={data.builtAt}
        searchUrl="/marketplace/all.json"
        href={PLUGIN_HREF}
      />
    )
  }
</Base>


{/* Inline, not bundled: a bundled sheet reaches every page that imports this
    view, and a package-only index must render exactly as it did before it
    had a marketplace. Classes are unique to this view, so nothing needs
    scoping. */}
<style is:inline>
@layer grimoire {
  /* Layered so a user CSS file (unlayered) outranks these rules. */
  /* Label above the bar, and the bar wide enough for the whole add command
     (the landing hero's side-by-side label would cost it 8rem). */
  .hero-side.hero-side-stack {
    grid-template-columns: minmax(0, 50rem);
    gap: var(--grim-space-5);
  }
  .mk-hint {
    margin: 0;
    color: var(--grim-color-muted);
    font-size: var(--grim-text-sm);
  }
  .mk-harness,
  .mk-add {
    display: flex;
    flex-direction: column;
    gap: var(--grim-space-3);
    min-width: 0;
  }
  /* Harness cards: native radios, visually hidden but still focusable, with
     the label as the card. Wraps on narrow screens. */
  .mk-picks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--grim-space-3);
  }
  .mk-pick {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--grim-space-3);
    padding: var(--grim-space-3) var(--grim-space-5);
    background: var(--grim-color-card);
    border: var(--grim-border-width) solid var(--grim-color-border);
    border-radius: var(--grim-radius-control);
    color: var(--grim-color-muted);
    font-size: var(--grim-text-sm);
    cursor: pointer;
  }
  .mk-pick input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .mk-pick svg {
    flex: none;
  }
  /* A hidden bold copy reserves the selected width, so picking a card does
     not resize it and reflow the row. */
  .mk-pick span[data-label] {
    display: inline-flex;
    flex-direction: column;
  }
  .mk-pick span[data-label]::after {
    content: attr(data-label);
    font-weight: 600;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }
  .mk-pick:hover {
    background: var(--grim-color-chip-bg);
    color: var(--grim-color-fg);
  }
  .mk-pick:has(input:checked) {
    border-color: var(--grim-color-accent);
    background: var(--grim-color-chip-bg);
    color: var(--grim-color-accent);
    font-weight: 600;
  }
  .mk-pick:has(input:focus-visible) {
    outline: 2px solid var(--grim-color-accent);
    outline-offset: 2px;
  }
}
</style>
