---
// Frozen public URL: /p/<namespace>/<name>/. grim resolves against it, the
// VS Code deep link points at it, and search engines index it — the route
// shape is a contract, not an implementation detail.
import {
  BookOpen,
  Bug,
  ChevronRight,
  FolderRoot,
  Globe,
  History,
  House,
  Image,
  ImageOff,
  Mail,
  MessageCircle,
  Scale,
  ShieldAlert,
  User,
} from "lucide-preact";
import Base from "../../layouts/Base.astro";
import VersionMenu from "../../components/VersionMenu.astro";
import CommandField from "../../components/CommandField.astro";
import PickerMenu from "../../components/PickerMenu.astro";
import { BrandMark } from "../../components/BrandMark.tsx";
import {
  mdiBitbucket,
  mdiGit,
  mdiGithub,
  mdiGitlab,
  mdiMicrosoftVisualStudioCode,
} from "@mdi/js";
import { withBase } from "../../lib/base";
import { SHIKI_THEMES } from "../../lib/code";
import {
  compareVersions,
  externalUrl,
  lastUpdated,
  resolveMemberRef,
  timeAgo,
  versionCascade,
  vscodeUrl,
  type CatalogPackage,
} from "../../lib/catalog";
import { data } from "../../lib/data";
import { getEntry, render } from "astro:content";
import { Code } from "astro:components";

export function getStaticPaths() {
  return data.packages.map((pkg) => ({
    params: { slug: `${pkg.namespace}/${pkg.name}` },
    props: { pkg },
  }));
}

const { config, packages } = data;
const { pkg } = Astro.props as { pkg: CatalogPackage };
const id = `${pkg.namespace}/${pkg.name}`;

const readmeEntry = await getEntry("readmes", id);
const changelogEntry = await getEntry("changelogs", id);
const Readme = readmeEntry ? (await render(readmeEntry)).Content : null;
const Changelog = changelogEntry ? (await render(changelogEntry)).Content : null;

// What the artifact actually is, as opposed to what its README says about
// itself. Three shapes, one per kind family: a skill, rule or agent carries
// its entry-point markdown; a bundle carries the list it installs; an MCP
// server carries its descriptor. `enrich` writes whichever applies.
const contentsEntry = await getEntry("contents", id);
const Contents = contentsEntry ? (await render(contentsEntry)).Content : null;
const contentsData = (await getEntry("contentData", id))?.data as
  | { members?: { kind?: string; name?: string; id?: string }[] }
  | undefined;

// Members resolved against this index: a member published elsewhere has no
// page here, so it is named without a link rather than linked into a 404.
const memberList = contentsData?.members ?? [];
const members = memberList.map((member) => {
  const ref = member.id ? resolveMemberRef(pkg.ref, member.id) : null;
  const target = ref ? packages.find((p) => p.ref === ref) : undefined;
  return {
    kind: member.kind ?? "",
    name: member.name ?? ref ?? "",
    ref,
    href: target ? withBase(`/p/${target.namespace}/${target.name}/`) : null,
  };
});

const tags = [...(pkg.tags ?? [])].sort(compareVersions);
const cascade = versionCascade(pkg.version, tags);
const older = tags.filter((t) => !cascade.includes(t));
// Highlight what an untagged `grim add` actually installs. That is `latest`
// wherever it was published — the exact release is one of the things latest
// currently points at, not the default.
const defaultTag = cascade.includes("latest") ? "latest" : (pkg.version ?? cascade[0]);

// The forge the repository link points at, drawn as its own mark. `mdiGit`
// is the honest fallback for a host with no brand in the set — it still says
// "source repository", where a generic branch glyph said nothing.
const FORGES = [
  { match: /(^|\.)github\.com$/i, path: mdiGithub },
  { match: /(^|\.)gitlab\.[a-z.]+$/i, path: mdiGitlab },
  { match: /(^|\.)bitbucket\.org$/i, path: mdiBitbucket },
];
const repoHost = URL.canParse(pkg.repository ?? "") ? new URL(pkg.repository!).hostname : "";
const repoMark = FORGES.find((f) => f.match.test(repoHost))?.path ?? mdiGit;

// Which tabs have anything behind them. An empty one is offered but not
// selectable — greyed in the ribbon rather than clickable through to a
// sentence apologising for itself. The first tab that does have content is
// the one that opens, so a package with no README does not land on a blank.
const filled = {
  readme: Readme !== null,
  contents: Contents !== null || members.length > 0 || contentsData !== undefined,
  changelog: Changelog !== null,
};
const openTab = (["readme", "contents", "changelog"] as const).find((tab) => filled[tab]) ?? null;

const title = pkg.title ?? pkg.name;
const description = pkg.summary ?? pkg.description ?? `${pkg.kind} package: ${pkg.ref}`;
const vscode = vscodeUrl(config.vscodeExtension, pkg.ref);
const addCommand = `grim add ${pkg.ref}`;

// The same two-way scope choice the package cards offer and the hero's
// registry bar draws, with the same two glyphs and the same order — global
// first, because it needs no project open.
const scopeChoices = [
  { name: "Global", command: `grim add --global ${pkg.ref}`, Icon: Globe },
  { name: "Project", command: addCommand, Icon: FolderRoot },
];

// Every outbound string on this page was handed to the index by a registry
// it does not control, so each one goes through the scheme allowlist before
// it becomes an href — the repository link included, which predates the rest
// of them and took the same string unchecked.
const repository = externalUrl(pkg.repository);
const homepage = externalUrl(pkg.url);
const documentation = externalUrl(pkg.documentation);

// Who publishes this, as one line under the summary. `vendor` is derived
// from the repository namespace when the publisher set none, so it is often
// the same string as `authors` — a set, not a join, keeps it from being
// printed twice.
const byline = [...new Set([pkg.authors, pkg.vendor].filter(Boolean))].join(" · ");

// "Get help" belongs to the *repository*, not this version: it is read off
// the description companion, so a maintainer moves a link without any
// artifact digest moving. Built here and rendered only when a channel is
// actually set — most repositories publish none, and a block of four dead
// rows is worse than no block.
const supportChannels = [
  { label: "Issue tracker", href: externalUrl(pkg.support?.issues), Icon: Bug },
  { label: "Chat", href: externalUrl(pkg.support?.chat), Icon: MessageCircle },
  { label: "Contact", href: externalUrl(pkg.support?.contact), Icon: Mail },
  { label: "Report a vulnerability", href: externalUrl(pkg.support?.security), Icon: ShieldAlert },
].filter((channel): channel is { label: string; href: string; Icon: typeof Bug } =>
  channel.href !== null,
);

// A commit SHA is not something to read, it is something to check against a
// checkout. It rides as the tooltip on the date it explains rather than
// taking a row of its own and putting 40 hex characters in the rail.
const updated = lastUpdated(pkg);
const updatedTitle = pkg.revision ? `${updated} · revision ${pkg.revision}` : updated;
---

<Base title={`${title} — ${config.brand}`} description={description} image={pkg.logo}>
  <div class="detail">
    <header class="detail-head" data-slot="detail-header">
      {
        pkg.logo ? (
          // The placeholder ships in the markup and the image fades in over
          // it, so a slow or failing load never flashes a broken glyph. The
          // slot starts `loading`; the handler in `Base.astro` moves it to
          // `ready` or `broken`. Icon mirrors `LogoMark` in `Catalog.tsx`.
          <span class="tile logo-slot" data-static data-state="loading">
            {/* Both marks ship; CSS shows one per state. The card grid picks
                between them in Preact instead, but this page has to settle
                its placeholder before any script runs. */}
            <Image class="logo-mark mark-loading" aria-hidden="true" />
            <ImageOff class="logo-mark mark-broken" aria-hidden="true" />
            <img src={withBase(pkg.logo)} alt="" />
          </span>
        ) : (
          <div class="tile letter" style={`background: var(--grim-color-kind-${pkg.kind}, var(--grim-color-muted))`}>
            {pkg.name[0]?.toUpperCase()}
          </div>
        )
      }
      <div class="detail-head-text">
        <h1>
          {pkg.name} <span class={`badge kind-${pkg.kind}`}>{pkg.kind}</span>
          {/* Skills only — every other kind reports null, and grim's own
              surfaces show it beside the kind for the same reason: it
              qualifies what the thing is, not what it says about itself. */}
          {pkg.compatibility && <span class="badge compat">{pkg.compatibility}</span>}
        </h1>
        {description && <p class="summary">{description}</p>}
        {byline && <p class="byline">by {byline}</p>}
      </div>
    </header>

    {
      pkg.deprecated && (
        <p class="deprecated-banner" data-slot="deprecated-banner">
          ⚠️ deprecated{pkg.replacedBy ? ` — replaced by ${pkg.replacedBy}` : ""}
        </p>
      )
    }

    <div class="cmd-bar" data-os-switch data-os-noun={`add command for ${pkg.name}`}>
      <PickerMenu choices={scopeChoices} title="Scope" label="Choose the scope" />
      <CommandField
        value={scopeChoices[0].command}
        name={`${scopeChoices[0].name} add command for ${pkg.name}`}
        label="Copy the add command"
      />
      {
        vscode && (
          <a
            class="seg brand-link"
            href={vscode}
            title="Open in VS Code"
            aria-label={`Open ${pkg.name} in VS Code`}
          >
            <BrandMark path={mdiMicrosoftVisualStudioCode} />
          </a>
        )
      }
    </div>

    <div class="detail-body" data-slot="detail-body">
      <main class="detail-main">
        {/* Radio tabs, not a scripted tablist: the ribbon works on a page
            whose JS never ran, and a radio group already has the keyboard
            behaviour tabs want (arrows move, only one selected). The inputs
            are visually hidden rather than `hidden`, which would take them
            out of the focus order along with the pixels. */}
        {/* All three tabs are always offered — a ribbon that grows a tab per
            package makes the panel a different shape on every page. An empty
            one is disabled instead: greyed, not clickable through to a
            sentence apologising for itself. */}
        <input
          type="radio"
          name="panel"
          id="panel-readme"
          class="sr-only"
          checked={openTab === "readme"}
          disabled={!filled.readme}
        />
        <input
          type="radio"
          name="panel"
          id="panel-contents"
          class="sr-only"
          checked={openTab === "contents"}
          disabled={!filled.contents}
        />
        <input
          type="radio"
          name="panel"
          id="panel-changelog"
          class="sr-only"
          checked={openTab === "changelog"}
          disabled={!filled.changelog}
        />
        {/* The greyed tab says it is not for clicking; the tooltip says why,
            so the answer is one hover away instead of a panel of its own. */}
        <div class="ribbon">
          <label for="panel-readme" title={filled.readme ? undefined : "no readme available"}>
            Readme
          </label>
          <label for="panel-contents" title={filled.contents ? undefined : "no contents available"}>
            Contents
          </label>
          <label
            for="panel-changelog"
            title={filled.changelog ? undefined : "no changelog available"}
          >
            Changelog
          </label>
        </div>
        {filled.readme && (
          <div class="prose tab-panel" id="tab-readme">
            <Readme />
          </div>
        )}
        {
          filled.contents && (
            <div class="prose tab-panel" id="tab-contents">
              {Contents ? (
                <Contents />
              ) : members.length > 0 ? (
                <ul class="members">
                  {members.map((member) => (
                    <li>
                      {member.href ? (
                        <a href={member.href}>{member.name}</a>
                      ) : (
                        <span>{member.name}</span>
                      )}
                      <span class={`badge kind-${member.kind}`}>{member.kind}</span>
                      <code>{member.ref}</code>
                    </li>
                  ))}
                </ul>
              ) : (
                <Code
                  code={JSON.stringify(contentsData, null, 2)}
                  lang="json"
                  themes={SHIKI_THEMES}
                />
              )}
            </div>
          )
        }
        {filled.changelog && (
          <div class="prose tab-panel" id="tab-changelog">
            <Changelog />
          </div>
        )}
        {/* Nothing anywhere: one statement in the middle of the panel, rather
            than three tabs each denying it separately. */}
        {openTab === null && <p class="panel-empty">No content available.</p>}
      </main>

      <aside class="detail-rail" data-slot="detail-rail">
        {tags.length > 0 && (
          <section>
            <h2>Versions</h2>
            <div class="cascade">
              {cascade.map((tag) => (
                <VersionMenu pkgRef={pkg.ref} tag={tag} current={tag === defaultTag} />
              ))}
            </div>
            {older.length > 0 && (
              <details class="older">
                <summary>
                  <ChevronRight size={14} aria-hidden="true" />
                  older versions
                </summary>
                <div class="cascade">
                  {older.map((tag) => (
                    <VersionMenu pkgRef={pkg.ref} tag={tag} />
                  ))}
                </div>
              </details>
            )}
          </section>
        )}

        <section>
          <h2>Details</h2>
          <dl>
            {pkg.license && (
              <>
                <dt>
                  <Scale size={15} aria-hidden="true" />
                  License
                </dt>
                <dd>{pkg.license}</dd>
              </>
            )}
            {repository && (
              <>
                <dt>
                  <BrandMark path={repoMark} size={15} />
                  Repository
                </dt>
                <dd>
                  <a href={repository} target="_blank" rel="noopener noreferrer">
                    source
                  </a>
                </dd>
              </>
            )}
            {homepage && (
              <>
                <dt>
                  <House size={15} aria-hidden="true" />
                  Homepage
                </dt>
                <dd>
                  <a href={homepage} target="_blank" rel="noopener noreferrer">
                    website
                  </a>
                </dd>
              </>
            )}
            {documentation && (
              <>
                <dt>
                  <BookOpen size={15} aria-hidden="true" />
                  Docs
                </dt>
                <dd>
                  <a href={documentation} target="_blank" rel="noopener noreferrer">
                    documentation
                  </a>
                </dd>
              </>
            )}
            {pkg.owner?.github && (
              <>
                <dt>
                  <User size={15} aria-hidden="true" />
                  Owner
                </dt>
                <dd>
                  <a
                    href={`https://github.com/${pkg.owner.github}`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {pkg.owner.github}
                  </a>
                </dd>
              </>
            )}
            {updated && (
              <>
                <dt>
                  <History size={15} aria-hidden="true" />
                  Updated
                </dt>
                <dd>
                  <time datetime={updated} title={updatedTitle}>
                    {timeAgo(updated) || updated}
                  </time>
                </dd>
              </>
            )}
          </dl>
          {pkg.keywords && pkg.keywords.length > 0 && (
            <ul class="keywords">
              {pkg.keywords.map((k) => (
                <li>
                  {/* Back to the catalog with the term already in the search
                      box — a keyword is only useful if it leads somewhere. */}
                  <a
                    href={withBase(`/?q=${encodeURIComponent(k)}`)}
                    title={`Find packages tagged ${k}`}
                  >
                    {k}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>

        {supportChannels.length > 0 && (
          <section class="support">
            <h2>Get help</h2>
            <ul>
              {supportChannels.map(({ label, href, Icon }) => (
                <li>
                  <Icon size={15} aria-hidden="true" />
                  <a href={href} target="_blank" rel="noopener noreferrer">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </div>
</Base>

<script>
  // Right-click a version: open its command menu at the pointer. The menu is
  // a `manual` popover (see VersionMenu.astro), so dismissal is ours.
  // Copying itself rides the shared [data-copy] listener in Base.astro.
  let openMenu: HTMLElement | null = null;
  const closeMenu = () => {
    openMenu?.hidePopover();
    openMenu = null;
  };
  // A right-click fires no `click`, so this never eats the gesture that just
  // opened the menu — but it does close on a command item, which is wanted.
  document.addEventListener("click", closeMenu);
  document.addEventListener("scroll", closeMenu, true);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeMenu();
  });

  for (const seg of document.querySelectorAll<HTMLElement>("[data-menu]")) {
    const menu = document.getElementById(seg.dataset.menu ?? "");
    if (!menu) continue;
    seg.addEventListener("contextmenu", (e) => {
      e.preventDefault();
      closeMenu();
      // The keyboard Menu key fires contextmenu at 0,0 — fall back to the
      // segment itself so it doesn't land in the page corner.
      const seat = seg.getBoundingClientRect();
      menu.style.left = `${e.clientX || seat.left}px`;
      menu.style.top = `${e.clientY || seat.bottom}px`;
      menu.showPopover();
      openMenu = menu;
      // Nudge back inside once measured — the pointer can be within a menu's
      // width of the right or bottom edge.
      const box = menu.getBoundingClientRect();
      if (box.right > innerWidth) menu.style.left = `${innerWidth - box.width - 8}px`;
      if (box.bottom > innerHeight) menu.style.top = `${innerHeight - box.height - 8}px`;
    });
  }
</script>

<style>
@layer grimoire {
  /* Layered so a user CSS file (unlayered) outranks these rules. Astro
     scopes a component style to `.foo[data-astro-cid-…]` — specificity
     (0,2,0) — which beats a consumer's `.foo` in EITHER source order, so
     source order alone does not make this overridable. Not reindented:
     the wrapper stays a two-line diff. */
  .detail {
    display: flex;
    flex-direction: column;
    gap: var(--grim-space-7);
  }
  .detail-head {
    display: flex;
    align-items: center;
    gap: var(--grim-space-6);
    background: var(--grim-color-card);
    border: var(--grim-border-width) solid var(--grim-color-border);
    border-radius: var(--grim-radius-xl);
    padding: var(--grim-space-6) var(--grim-space-7);
  }
  .tile {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--grim-radius-xl);
    object-fit: cover;
  }
  .tile.letter {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--grim-color-on-accent);
    font-size: var(--grim-text-xl);
    font-weight: 700;
    font-family: ui-monospace, "SFMono-Regular", monospace;
  }
  .detail-head-text h1 {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--grim-space-4);
    font-size: var(--grim-text-xl);
    font-family: ui-monospace, "SFMono-Regular", monospace;
  }
  .summary {
    margin: var(--grim-space-2) 0 0;
    color: var(--grim-color-muted);
  }
  .byline {
    margin: var(--grim-space-3) 0 0;
    color: var(--grim-color-muted);
    font-size: var(--grim-text-sm);
  }
  /* The kind badge names a closed set of five and shouts accordingly. A
     compatibility hint is a free string off the registry — upper-casing it
     would misspell whatever the publisher actually wrote. */
  .badge.compat {
    text-transform: none;
    letter-spacing: normal;
    font-family: ui-monospace, "SFMono-Regular", monospace;
  }
  .support ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--grim-space-4);
  }
  .support li {
    display: flex;
    align-items: center;
    gap: var(--grim-space-3);
    font-size: var(--grim-text-md);
  }
  .support li :global(svg) {
    flex-shrink: 0;
    color: var(--grim-color-muted);
  }
  .deprecated-banner {
    margin: 0;
    background: var(--grim-color-banner-bg);
    color: var(--grim-color-banner-fg);
    border: var(--grim-border-width) solid var(--grim-color-banner-border);
    border-radius: var(--grim-radius-lg);
    padding: var(--grim-space-4) var(--grim-space-6);
    font-weight: 600;
  }
  .detail-body {
    display: grid;
    grid-template-columns: 1fr 18rem;
    gap: var(--grim-space-8);
    align-items: start;
  }
  @media (max-width: 55rem) {
    .detail-body {
      grid-template-columns: 1fr;
    }
  }
  .detail-main {
    min-width: 0;
    background: var(--grim-color-card);
    border: var(--grim-border-width) solid var(--grim-color-border);
    border-radius: var(--grim-radius-xl);
    padding: var(--grim-space-7) var(--grim-space-7);
  }
  /* Markdown opens with its own heading, whose margin lands on top of the
     panel padding and reads as a hole. Every panel sets its own top edge. */
  .prose > :global(:first-child) {
    margin-block-start: 0;
  }
  .detail-main :global(img) {
    max-width: 100%;
  }
  .detail-main :global(pre) {
    overflow-x: auto;
  }
  /* Full-bleed inside the panel's padding, so the rule under it reads as the
     panel's own top edge rather than a line floating in the content. */
  .ribbon {
    display: flex;
    gap: var(--grim-space-7);
    /* The negation of `.detail-main`'s own padding, written as that token so
       the two cannot drift apart into a bleed that no longer reaches the edge. */
    margin: calc(-1 * var(--grim-space-7)) calc(-1 * var(--grim-space-7))
      var(--grim-space-7);
    padding: 0 var(--grim-space-7);
    border-bottom: var(--grim-border-width) solid var(--grim-color-border);
  }
  .ribbon label {
    padding: var(--grim-space-5) 0;
    margin-bottom: calc(-1 * var(--grim-border-width)); /* the active underline sits on the panel rule */
    border-bottom: 2px solid transparent;
    font-size: var(--grim-text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--grim-color-muted);
    cursor: pointer;
  }
  .ribbon label:hover {
    color: var(--grim-color-fg);
  }
  /* Nothing behind it. Still shown, so the ribbon is the same shape on every
     package page, but visibly not a thing to click. */
  #panel-readme:disabled ~ .ribbon label[for="panel-readme"],
  #panel-contents:disabled ~ .ribbon label[for="panel-contents"],
  #panel-changelog:disabled ~ .ribbon label[for="panel-changelog"] {
    opacity: 0.4;
    cursor: default;
  }
  #panel-readme:disabled ~ .ribbon label[for="panel-readme"]:hover,
  #panel-contents:disabled ~ .ribbon label[for="panel-contents"]:hover,
  #panel-changelog:disabled ~ .ribbon label[for="panel-changelog"]:hover {
    color: var(--grim-color-muted);
  }
  /* Every tab empty: say it once, in the middle. */
  .panel-empty {
    display: grid;
    place-items: center;
    min-height: 11rem;
    margin: 0;
    color: var(--grim-color-muted);
  }
  .tab-panel {
    display: none;
  }
  #panel-readme:checked ~ #tab-readme,
  #panel-contents:checked ~ #tab-contents,
  #panel-changelog:checked ~ #tab-changelog {
    display: block;
  }
  #panel-readme:checked ~ .ribbon label[for="panel-readme"],
  #panel-contents:checked ~ .ribbon label[for="panel-contents"],
  #panel-changelog:checked ~ .ribbon label[for="panel-changelog"] {
    color: var(--grim-color-fg);
    border-bottom-color: var(--grim-color-accent);
  }
  /* The input carries the focus, the label shows it. */
  #panel-readme:focus-visible ~ .ribbon label[for="panel-readme"],
  #panel-contents:focus-visible ~ .ribbon label[for="panel-contents"],
  #panel-changelog:focus-visible ~ .ribbon label[for="panel-changelog"] {
    outline: 2px solid var(--grim-color-accent);
    outline-offset: 2px;
    border-radius: var(--grim-radius-sm);
  }

  /* A bundle's member list: what it installs, one row each. A grid, not a
     row of flex items — names and badges of different widths have to line up
     down the column, which is the whole reason to list them. `subgrid` puts
     each <li>'s three cells on the parent's tracks. */
  .members {
