---
// Frozen public URL: /p/<namespace>/<name>/. grim resolves against it, the
// VS Code deep link points at it, and search engines index it — the route
// shape is a contract, not an implementation detail.
import PackageDetail from "../../components/PackageDetail.astro";
import { addArtifactChoices } from "../../lib/commands";
import { data } from "../../lib/data";
import { getEntry } from "astro:content";
import type { CatalogPackage } from "../../lib/catalog";

export function getStaticPaths() {
  return data.packages.map((pkg) => ({
    params: { slug: `${pkg.namespace}/${pkg.name}` },
    props: { pkg },
  }));
}

const { pkg } = Astro.props as { pkg: CatalogPackage };
const id = `${pkg.namespace}/${pkg.name}`;
---

<PackageDetail
  pkg={pkg}
  readmeEntry={await getEntry("readmes", id)}
  changelogEntry={await getEntry("changelogs", id)}
  install={{
    // The same two-way scope choice the package cards offer and the hero's
    // registry bar draws, from the one helper all three read.
    choices: addArtifactChoices(pkg.ref),
    noun: `add command for ${pkg.name}`,
    copyLabel: "Copy the add command",
    pickerTitle: "Scope",
    pickerLabel: "Choose the scope",
  }}
/>
