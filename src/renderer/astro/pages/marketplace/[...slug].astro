---
// Frozen public URL: /marketplace/, present only beside a package catalog
// (`both` mode); with no packages the marketplace is `/` itself. A rest route
// rather than `marketplace.astro` because a plain page cannot opt out of being
// emitted — an empty `getStaticPaths` can.
import MarketplaceView from "../../components/MarketplaceView.astro";
import { data } from "../../lib/data";

export function getStaticPaths() {
  // `slug: undefined` is the rest parameter matching the bare `/marketplace/`.
  return data.siteMode === "both" ? [{ params: { slug: undefined } }] : [];
}

const { brand } = data.config;
---

<MarketplaceView
  title={`${brand} · plugin marketplace`}
  description={`Add the ${brand} plugin marketplace to your AI coding client.`}
/>
