# Generated by ocx — run 'direnv allow' to activate
# Requires: direnv (https://direnv.net)
#
# `-g default,node24`: node lives in a version group rather than [tools], so
# an unqualified export would put no node on PATH at all. See ocx.toml.
watch_file ocx.toml ocx.lock
eval "$(ocx direnv export -g default,node24)"
