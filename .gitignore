node_modules
dist/
coverage/

# `task docs:build` output. The docs site is published from CI, never committed.
site/

# Local materialized toolchain (ocx) and task's checksum cache.
.ocx/
.task/
.dev/
*.log
.DS_Store
.test-index-*/

# Serena MCP server state — per-machine tooling residue, never source.
.serena/

# Claude Code local state is tooling residue, but the rule catalog and the
# rules themselves are source: they are the written half of the theming
# contract that `test/renderer/style_contract.test.ts` enforces. A rule that
# is not committed is a rule only one machine has.
# `.claude/*`, not `.claude/`: git does not descend into an excluded
# directory, so a trailing-slash ignore cannot be negated from inside.
.claude/*
!.claude/rules.md
!.claude/rules/

# Ephemeral agent worktrees (hex work packages). Never committed.
.agents/worktrees/
